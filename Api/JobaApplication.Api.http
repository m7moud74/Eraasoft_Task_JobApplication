@HostAddress = http://localhost:5102

### 1. Register a new Candidate
POST {{HostAddress}}/api/auth/register
Content-Type: application/json

{
  "name": "Mahmoud Hassan",
  "email": "mahmoud@example.com",
  "password": "Password@123",
  "cvUrl": "https://example.com/cvs/mahmoud.pdf",
  "role": "Candidate"
}

### 2. Attempt Public Recruiter Registration (Fails 400 - Recruiters must be added by a company)
POST {{HostAddress}}/api/auth/register
Content-Type: application/json

{
  "name": "Karim Recruiter",
  "email": "karim@company.com",
  "password": "Password@123",
  "role": "Recruiter"
}

### 3. Login as Admin
# @name adminLogin
POST {{HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "admin@trackapplication.com",
  "password": "Admin@123456"
}

### 4. Login as Recruiter
# @name recruiterLogin
POST {{HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "recruiter@trackapplication.com",
  "password": "Recruiter@123456"
}

### 5. Login as Candidate (Ahmed - Id: 1)
# @name candidateLogin
POST {{HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "ahmed@example.com",
  "password": "Candidate@123456"
}

### 6. Login as Candidate (Sara - Id: 2)
# @name candidate2Login
POST {{HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "sara@example.com",
  "password": "Candidate@123456"
}

### Store Token Variables (Replace manually or use in REST Client)
@adminToken = {{adminLogin.response.body.token}}
@recruiterToken = {{recruiterLogin.response.body.token}}
@candidateToken = {{candidateLogin.response.body.token}}
@candidate2Token = {{candidate2Login.response.body.token}}

###############################################################################
# JOBS CRUD & LIFECYCLE
###############################################################################

### Get All Jobs (Public)
GET {{HostAddress}}/api/jobs
Accept: application/json

### Get Job By ID (Public)
GET {{HostAddress}}/api/jobs/1
Accept: application/json

### Create Job (Recruiter or Admin)
POST {{HostAddress}}/api/jobs
Content-Type: application/json
Authorization: Bearer {{recruiterToken}}

{
  "title": "Backend .NET Engineer",
  "description": "Design and build high-performance web APIs with Clean Architecture",
  "isActive": true
}

### Update Job (Only creator recruiter can update)
PUT {{HostAddress}}/api/jobs/1
Content-Type: application/json
Authorization: Bearer {{recruiterToken}}

{
  "title": "Lead .NET Architect",
  "description": "Oversee enterprise architecture and API design",
  "isActive": true
}

### Close Job (Only the creator who opened the job can close it - Not any Admin!)
PUT {{HostAddress}}/api/jobs/1/close
Authorization: Bearer {{recruiterToken}}

### Attempt Close Job with Admin (Fails 403 because Admin did not open this job)
PUT {{HostAddress}}/api/jobs/1/close
Authorization: Bearer {{adminToken}}

### Delete Job (Admin or Job Creator - fails if applications exist)
DELETE {{HostAddress}}/api/jobs/1
Authorization: Bearer {{recruiterToken}}

###############################################################################
# CANDIDATES CRUD & PERMISSIONS
###############################################################################

### Get All Candidates (Admin Only)
GET {{HostAddress}}/api/candidates
Authorization: Bearer {{adminToken}}

### Get Candidate By ID (Admin or own profile)
GET {{HostAddress}}/api/candidates/1
Authorization: Bearer {{candidateToken}}

### Update Candidate Profile (Candidate ONLY - Admin cannot update candidate)
PUT {{HostAddress}}/api/candidates/1
Content-Type: application/json
Authorization: Bearer {{candidateToken}}

{
  "name": "Ahmed Ali Updated",
  "cvUrl": "https://example.com/cvs/ahmed-v2.pdf"
}

### Attempt to Update Candidate Profile with Admin (Fails 403 - Only candidate can update)
PUT {{HostAddress}}/api/candidates/1
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "name": "Hacked by Admin",
  "cvUrl": "https://example.com/cvs/hacked.pdf"
}

### Delete Candidate Profile (Both Admin and Candidate can delete)
### Option A: Candidate deletes their own profile
DELETE {{HostAddress}}/api/candidates/1
Authorization: Bearer {{candidateToken}}

### Option B: Admin deletes candidate profile
# DELETE {{HostAddress}}/api/candidates/2
# Authorization: Bearer {{adminToken}}

###############################################################################
# APPLICATIONS CRUD & LIFECYCLE
###############################################################################

### Apply to a Job (Candidate Only - CandidateId resolved from token)
POST {{HostAddress}}/api/applications
Content-Type: application/json
Authorization: Bearer {{candidateToken}}

{
  "jobId": 2
}

### Get My Applications (Candidate Only)
GET {{HostAddress}}/api/applications/my
Authorization: Bearer {{candidateToken}}

### Get Application By ID (Owner Candidate, Job Creator Recruiter, or Admin)
GET {{HostAddress}}/api/applications/1
Authorization: Bearer {{candidateToken}}

### Get Applications for a Job (Job Creator Recruiter or Admin)
GET {{HostAddress}}/api/applications/job/1
Authorization: Bearer {{recruiterToken}}

### Update Application Status (Only the Recruiter who opened the job can update its status)
PUT {{HostAddress}}/api/applications/1/status
Content-Type: application/json
Authorization: Bearer {{recruiterToken}}

{
  "status": 2
}

### Attempt Update Application Status with another user (Fails 403)
PUT {{HostAddress}}/api/applications/1/status
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "status": 3
}

### Cancel Application (Candidate Only)
DELETE {{HostAddress}}/api/applications/1
Authorization: Bearer {{candidateToken}}

###############################################################################
# COMPANY & RECRUITER MANAGEMENT
###############################################################################

### 1. Register a new Company (Starts as Pending)
POST {{HostAddress}}/api/companies/register
Content-Type: application/json

{
  "name": "Acme Innovations",
  "description": "Building modern cloud native solutions",
  "logoUrl": "https://example.com/acme.png",
  "ownerName": "John Acme",
  "email": "john@acme.com",
  "password": "Password@123"
}

### 2. Attempt login as owner of Pending Company (Fails 400 - Pending approval)
POST {{HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "john@acme.com",
  "password": "Password@123"
}

### 3. Admin: View Pending Companies
GET {{HostAddress}}/api/companies/pending
Authorization: Bearer {{adminToken}}

### 4. Admin: View All Companies
GET {{HostAddress}}/api/companies
Authorization: Bearer {{adminToken}}

### 5. Admin: Approve Company (e.g. Id 2 which is seeded as Pending)
PUT {{HostAddress}}/api/companies/2/approve
Authorization: Bearer {{adminToken}}

### 6. Login as Approved Recruiter/Company Owner (Tech Solutions Recruiter)
# @name approvedRecruiterLogin
POST {{HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "recruiter@trackapplication.com",
  "password": "Recruiter@123456"
}

@approvedRecruiterToken = {{approvedRecruiterLogin.response.body.token}}

### 7. Company Owner: Add a new Recruiter to own Company
POST {{HostAddress}}/api/companies/recruiters
Content-Type: application/json
Authorization: Bearer {{approvedRecruiterToken}}

{
  "name": "Alice Recruiter",
  "email": "alice@trackapplication.com",
  "password": "Password@123"
}

### 8. Company Owner: View own Company's Recruiters
GET {{HostAddress}}/api/companies/recruiters
Authorization: Bearer {{approvedRecruiterToken}}

### 9. Admin: View Recruiters for a specific Company
GET {{HostAddress}}/api/companies/1/recruiters
Authorization: Bearer {{adminToken}}

### 10. Recruiter: Create Job associated with own Company
POST {{HostAddress}}/api/jobs
Content-Type: application/json
Authorization: Bearer {{approvedRecruiterToken}}

{
  "title": "Cloud Architect",
  "description": "Lead Azure and AWS cloud migrations",
  "isActive": true
}

###############################################################################
# CANDIDATE CV FILE UPLOAD (CLOUDINARY) & BACKGROUND EMAILS
###############################################################################

### 11. Candidate: Upload CV via multipart/form-data
POST {{HostAddress}}/api/candidates/1/cv
Authorization: Bearer {{candidateToken}}
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary7MA4YWxkTrZu0gW

------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="file"; filename="sample_cv.pdf"
Content-Type: application/pdf

%PDF-1.4 sample pdf content for testing
------WebKitFormBoundary7MA4YWxkTrZu0gW--

### 12. Candidate: Delete uploaded CV
DELETE {{HostAddress}}/api/candidates/1/cv
Authorization: Bearer {{candidateToken}}

### 13. Recruiter: Update Application Status to UnderReview (Triggers Hangfire Email)
PUT {{HostAddress}}/api/applications/1/status
Content-Type: application/json
Authorization: Bearer {{recruiterToken}}

{
  "status": "UnderReview"
}

### 14. Candidate: Cancel Application (Triggers Hangfire Email)
PUT {{HostAddress}}/api/applications/1/cancel
Authorization: Bearer {{candidateToken}}

###############################################################################
# PHASE 3: PAGINATION, FILTERING, SORTING & REDIS CACHING
###############################################################################

### 15. Get Jobs with Pagination, Filtering & Sorting (Default page 1, size 10)
GET {{HostAddress}}/api/jobs?page=1&pageSize=10&activeOnly=true&search=Developer&sortBy=createdAt&sortDirection=desc
Accept: application/json

### 16. Get Jobs (Page 2, size 1, sorted ascending) - Cached in Redis
GET {{HostAddress}}/api/jobs?page=2&pageSize=1&sortBy=createdAt&sortDirection=asc
Accept: application/json

### 17. Rate Limiting Test (Send >10 requests rapidly to /api/auth/login to trigger 429)
POST {{HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "admin@trackapplication.com",
  "password": "Admin@123456"
}

